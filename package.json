{
  "name": "@jayree/sfdx-plugin-source",
  "description": "A Salesforce CLI plugin containing commands to generate and compare sfdx source snapshot files or manipulate local source tracking.",
  "version": "1.3.184",
  "author": "jayree",
  "type": "module",
  "bugs": "https://github.com/jayree/sfdx-plugin-source/issues",
  "dependencies": {
    "@jayree/changelog": "^1.2.39",
    "@oclif/core": "^4.14.0",
    "@salesforce/core": "^9.1.4",
    "@salesforce/kit": "^4.0.0",
    "@salesforce/sf-plugins-core": "^13.0.3",
    "@salesforce/source-deploy-retrieve": "^13.2.0",
    "@salesforce/source-tracking": "^8.1.1",
    "@salesforce/ts-types": "^3.0.1",
    "ansis": "^4.3.1",
    "debug": "^4.4.3",
    "deep-object-diff": "^1.1.9",
    "fast-xml-parser": "^5.11.0",
    "fs-extra": "^11.4.0",
    "globby": "^16.2.4",
    "object-path": "^0.11.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@oclif/plugin-command-snapshot": "^5.3.35",
    "@oclif/plugin-help": "^6.2.58",
    "@salesforce/dev-scripts": "^13.0.2",
    "@salesforce/ts-sinon": "^1.4.36",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26",
    "@types/object-path": "^0.11.4",
    "@types/sinon": "^22.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.9.0",
    "eslint-config-oclif": "^7.1",
    "eslint-config-salesforce-typescript": "^6.0.0",
    "eslint-plugin-sf-plugin": "^3.0.0",
    "is-ci": "^4.1.0",
    "oclif": "^4.23.30",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "/CHANGELOG.md",
    "/lib",
    "/messages",
    "/npm-shrinkwrap.json",
    "/oclif.lock",
    "/oclif.manifest.json",
    "/schemas"
  ],
  "homepage": "https://github.com/jayree/sfdx-plugin-source",
  "keywords": [
    "source",
    "snapshot",
    "source",
    "tracking",
    "sfdx",
    "sfdx-plugin"
  ],
  "license": "Apache-2.0",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sfdx",
    "hooks": {
      "prerun": "./lib/hooks/prerun",
      "update": "./lib/hooks/changelog",
      "scopedPreRetrieve": "./lib/hooks/scopedPreRetrieve",
      "scopedPostRetrieve": "./lib/hooks/scopedPostRetrieve"
    },
    "topics": {
      "jayree": {
        "description": "manifest, source, and org automation toolset",
        "subtopics": {
          "project": {
            "description": "Work with projects, such as fix retrieved metadata.",
            "subtopics": {
              "store": {
                "description": "Store revision counter number.",
                "subtopics": {
                  "tracking": {
                    "description": "Store revision counter number."
                  }
                }
              }
            }
          }
        }
      }
    },
    "devPlugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-command-snapshot"
    ],
    "info": {
      "releasenotes": {
        "distTagUrl": "https://registry.npmjs.org/-/package/@jayree/sfdx-plugin-source/dist-tags",
        "releaseNotesPath": "https://github.com/jayree/sfdx-plugin-source/tree/main",
        "releaseNotesFilename": "CHANGELOG.md"
      }
    },
    "topicSeparator": " "
  },
  "repository": "jayree/sfdx-plugin-source",
  "scripts": {
    "build": "wireit",
    "clean": "sf-clean",
    "clean-all": "sf-clean all",
    "compile": "wireit",
    "docs": "sf-docs",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "postpack": "sf-clean --ignore-signing-artifacts",
    "prepack": "sf-prepack",
    "prepare": "patch-package && sf-install",
    "test": "wireit",
    "test:only": "wireit",
    "version": "oclif readme --no-aliases"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main",
      "next"
    ]
  },
  "wireit": {
    "build": {
      "dependencies": [
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "messages/**"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "format": {
      "command": "prettier --write \"+(src|test|schemas)/**/*.+(ts|js|json)|command-snapshot.json\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "schemas/**/*.json",
        "command-snapshot.json",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "messages/**",
        "**/eslint.config.*",
        "**/.eslint*",
        "**/tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "test:deprecation-policy",
        "lint",
        "test:json-schema"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json"
      ],
      "output": []
    },
    "test:deprecation-policy": {
      "command": "node \"./bin/dev.js\" snapshot:compare",
      "files": [
        "src/**/*.ts"
      ],
      "output": [],
      "dependencies": [
        "compile"
      ]
    },
    "test:json-schema": {
      "command": "node \"./bin/dev.js\" schema:compare",
      "files": [
        "src/**/*.ts",
        "schemas"
      ],
      "output": []
    },
    "test:only": {
      "command": "c8 mocha \"test/**/*.test.ts\"",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        ".mocha*",
        "!*.nut.ts",
        ".nycrc"
      ],
      "output": []
    }
  }
}
